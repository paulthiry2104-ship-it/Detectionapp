# ─────────────────────────────────────────────────────────────
# Crypto Radar — backend. Copie ce fichier en .env et remplis.
# AUCUNE de ces valeurs ne doit aller dans l'app mobile.
# ─────────────────────────────────────────────────────────────

# Serveur
PORT=8080
HOST=0.0.0.0
# Chemin de la base SQLite (mets-le sur un disque persistant en prod, ex. /data/radar.db)
DATABASE_PATH=./data/radar.db

# Clé que l'app mobile envoie dans l'en-tête x-app-key (lecture + favoris/alertes).
# Génère-la avec : openssl rand -hex 24
APP_API_KEY=change-me-app-key

# Clé réservée aux appels internes (déclenchement manuel / GitHub Actions).
# Génère-la avec : openssl rand -hex 32
INTERNAL_JOB_SECRET=change-me-internal-secret

# Planification (fuseau Paris, gestion heure d'été incluse)
SCHEDULER_ENABLED=true
TZ_SCHEDULE=Europe/Paris
DAILY_CRON=0 6 * * *
# Rafraîchissement des prix/volumes/liquidités (toutes les 3 h par défaut)
REFRESH_CRON=15 */3 * * *
# Détection des nouvelles paires / pics de volume (toutes les 20 min)
DISCOVERY_CRON=*/20 * * * *

# ── Fournisseurs de données ──
# CoinGecko : clé "Demo" gratuite (https://www.coingecko.com/en/api). Laisse vide = API publique (limites plus basses).
COINGECKO_API_KEY=
# "demo" ou "pro"
COINGECKO_PLAN=demo
# Nombre de pages de 250 coins à balayer (1 page = 1 requête). 4 = top 1000.
COINGECKO_MARKET_PAGES=4

# CoinMarketCal (catalyseurs datés). Optionnel : sans clé, seuls les catalyseurs saisis à la main avec source sont utilisés.
COINMARKETCAL_API_KEY=

# DexScreener, GeckoTerminal, GoPlus, RugCheck : pas de clé requise.
# Réseaux surveillés côté DEX (ids GeckoTerminal)
DEX_NETWORKS=solana,eth,base,bsc,arbitrum

# ── Notifications push (Expo) ──
# Optionnel : jeton d'accès Expo si tu actives "Enhanced security for push" dans ton compte Expo.
EXPO_ACCESS_TOKEN=

# Logs
LOG_LEVEL=info
