{
  "name": "crypto-radar-backend",
  "version": "0.1.0",
  "description": "Crypto Radar — backend, collecte, scoring et tâche quotidienne",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --disable-warning=ExperimentalWarning --import tsx src/index.ts",
    "job:daily": "node --disable-warning=ExperimentalWarning --import tsx src/jobs/cli.ts daily",
    "job:refresh": "node --disable-warning=ExperimentalWarning --import tsx src/jobs/cli.ts refresh",
    "job:discovery": "node --disable-warning=ExperimentalWarning --import tsx src/jobs/cli.ts discovery",
    "smoke": "node --disable-warning=ExperimentalWarning --import tsx scripts/smoke.ts",
    "test": "node --disable-warning=ExperimentalWarning --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "ci": "node --disable-warning=ExperimentalWarning --import tsx src/jobs/ci.ts"
  },
  "author": "Pablo",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "fastify": "^5.12.7",
    "node-cron": "^3.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/node-cron": "^3.0.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  }
}